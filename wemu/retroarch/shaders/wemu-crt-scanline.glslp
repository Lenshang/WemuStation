// WemuStation built-in shader presets (public domain).
shaders = "1"
shader0 = "shaders/wemu-crt-scanline.glsl"

filter_linear0 = "false"
wrap_mode0 = "clamp_to_border"
mipmap_input0 = "false"

alias0 = ""
float_framebuffer0 = "false"
srgb_framebuffer0 = "false"

parameters = "SCAN_INTENSITY"
SCAN_INTENSITY = "0.72"
